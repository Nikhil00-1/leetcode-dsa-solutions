/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    static boolean ans;

    public static void help(TreeNode node, int sum, int targetSum){
        if(node.left==null && node.right==null){
            if(sum+node.val==targetSum){
                ans=true;
            }
        }
        if(node.left!=null){
            help(node.left, sum+node.val, targetSum);
        }
        if(node.right!=null){
            help(node.right, sum+node.val, targetSum);
        }
        
    }
    public boolean hasPathSum(TreeNode root, int targetSum) {
        if(root==null){
            return false;
        }
        ans=false;
        help(root, 0, targetSum);

        if(ans==true){
            return true;
        }
        return ans;
        
    }
}
