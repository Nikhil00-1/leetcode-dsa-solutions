/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    static ArrayList<TreeNode> arr;
    public static void help(TreeNode node){
        if(node==null){
            return;
        }
        arr.add(node);
        help(node.left);
        help(node.right);
    }
    public void flatten(TreeNode root) {
        arr=new ArrayList<>();
        help(root);
        TreeNode temp=null;
        for(TreeNode node: arr){
            node.left=null;
            if(temp==null){
                temp=node;
            }else{
                temp.right=node;
                temp=node;
            }
        }
        
    }
}
