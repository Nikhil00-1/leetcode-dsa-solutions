/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    static int count;

    public static void help(TreeNode node, int curMax){
        if(node==null){
            return;
        }

        if(node.val>=curMax){
            count++;
            curMax=node.val;
        }
        help(node.left, curMax);
        help(node.right, curMax);
    }
    public int goodNodes(TreeNode root) {
        count=0;
        help(root, Integer.MIN_VALUE);
        return count;
    }
}
