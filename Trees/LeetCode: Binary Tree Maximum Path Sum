/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    static int max;
    public static int help(TreeNode node){    
        int left=0;
        int right=0;
        if(node.left!=null){
            left=help(node.left);
        }
        if(node.right!=null){
            right=help(node.right);
        }
        int sec=Math.max(left, right);
        max=Math.max(max, Math.max(node.val+left+right, Math.max(sec+node.val, node.val)));
        return Math.max(sec+node.val, node.val);
    }
    public int maxPathSum(TreeNode root) {
        max=Integer.MIN_VALUE;
        help(root);
        return max;
    }
}
