/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    static int total;
    public static void help(TreeNode node, int cur){
        if(node==null){
            return;
        }
        cur=(cur*10)+node.val;
        if(node.left==null && node.right==null){
            total=total+cur;
            return;
        }

        help(node.left, cur);
        help(node.right, cur);
    }
    public int sumNumbers(TreeNode root) {
        total=0;
        help(root, 0);
        return total;
    }
}
