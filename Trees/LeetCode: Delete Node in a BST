/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public static TreeNode help(TreeNode node, int key){
        if (node.left==null){
            return node.right;
        }else if(node.right==null){
            return node.left;
        }else{
            TreeNode tempright=node.right;
            TreeNode exright= findRight(node.left);
            exright.right=tempright;
            return node.left;
        }
    }

    public static TreeNode findRight(TreeNode node){
        while(node.right!=null){
            node=node.right;
        }
        return node;
    }
   
    public TreeNode deleteNode(TreeNode root, int key) {
        if(root==null){
            return null;
        }
        if(root.val==key){
            return help(root, key);
        }
        TreeNode temp=root;
        while(temp!=null){
            if(temp.val>key){
                if(temp!=null && temp.left!= null && temp.left.val==key){
                    temp.left=help(temp.left, key);
                    break;
                }else{
                    temp=temp.left;
                }
            }else{
                if(temp!=null && temp.right!=null && temp.right.val==key){
                    temp.right=help(temp.right, key);
                    break;
                }else{
                    temp=temp.right;
                }
            }
        }
        return root;
    }
}
