/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    static boolean ans;
    public static int help(TreeNode node){
        if(node==null){
            return 0;
        }
        int l=help(node.left);
        int r=help(node.right);
       
        if(Math.abs(l-r)>1){
            ans=false;
        }
        return Math.max(l,r)+1;
    }

    public boolean isBalanced(TreeNode root) {
        ans=true;
        help(root);
        if(ans==false){
            return false;
        }
        return true;

    }
}
