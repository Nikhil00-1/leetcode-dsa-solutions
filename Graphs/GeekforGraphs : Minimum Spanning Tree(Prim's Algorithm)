class Solution {
    public int primMST(ArrayList<ArrayList<ArrayList<Integer>>> adj) {
        
        int n=adj.size();
        PriorityQueue<int[]> queue=new PriorityQueue<>((a,b)->Integer.compare(a[0], b[0]));
        boolean[] visited=new boolean[n];
        
        queue.offer(new int[]{0,0});
        int ans=0;
        
        while(!queue.isEmpty()){
            
            int[] cur=queue.poll();
            //System.out.println(Arrays.toString(cur));
            if(visited[cur[1]]==false){
                ans+=cur[0];
            }
            
            visited[cur[1]]=true;
            for(ArrayList<Integer> dir:adj.get(cur[1])){
                if(visited[dir.get(0)]==false){
                    queue.offer(new int[]{dir.get(1), dir.get(0)});
                }
            }
        }
        
        return ans;
        
    }
}
