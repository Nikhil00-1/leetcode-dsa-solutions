import java.util.*;
class Solution {
    public static boolean isCycle;
    public static void dfs(int u,boolean[] visited, boolean[] inRecursion, ArrayList<ArrayList<Integer>> adj, Stack<Integer> st){
        inRecursion[u]=true;
        visited[u]=true;
        
        for(int v:adj.get(u)){
            if(visited[v]==false){
                dfs(v, visited, inRecursion, adj, st);
            }
            if(inRecursion[v]==true){
                isCycle=true;
                return;
            }
        }
        st.push(u);
        inRecursion[u]=false;
    }

    public int[] findOrder(int n, int[][] pre) {
        isCycle=false;
        ArrayList<ArrayList<Integer>> adj=new ArrayList<>();
        boolean[] visited=new boolean[n];
        for(int i=0;i<n;i++){
            adj.add(new ArrayList());
        }
        for(int[] cur:pre){
            adj.get(cur[1]).add(cur[0]);
        }

        Stack<Integer> st=new Stack<>();
        boolean[] inRecursion=new boolean[n];
        for(int i=0;i<n;i++){
            if(visited[i]==false){
                dfs(i, visited, inRecursion, adj, st);
            }
        }

        if(isCycle==true){
            return new int[0];
        }
        
        int[] ans=new int[n];

        for(int i=0;i<n;i++){
            ans[i]=st.pop();
        }
        return ans;
    }
}
