class Solution {
    public static void dfs(int i, int j, char[][] board){
        board[i][j]='1';
        int m=board.length;
        int n=board[0].length;
        if(i>0 && board[i-1][j]=='O'){
            dfs(i-1,j, board);
        }
        if(i<m-1 && board[i+1][j]=='O'){
            dfs(i+1,j, board);
        }
        if(j>0 && board[i][j-1]=='O'){
            dfs(i,j-1, board);
        }
        if(j<n-1 && board[i][j+1]=='O'){
            dfs(i,j+1,board);
        }
    }
    public void solve(char[][] board) {
        int m=board.length;
        int n=board[0].length;
        for(int i=0; i<n;i++){
            if(board[0][i]=='O'){
                dfs(0,i,board);
            }
        }
        for(int i=0; i<m;i++){
            if(board[i][n-1]=='O'){
                dfs(i,n-1,board);
            }
        }
        for(int i=0; i<m;i++){
            if(board[i][0]=='O'){
                dfs(i,0,board);
            }
        }
        for(int i=0; i<n;i++){
            if(board[m-1][i]=='O'){
                dfs(m-1,i,board);
            }
        }

        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(board[i][j]=='O'){
                    board[i][j]='X';
                }
                if(board[i][j]=='1'){
                    board[i][j]='O';
                }
            }
        }
    }
}
