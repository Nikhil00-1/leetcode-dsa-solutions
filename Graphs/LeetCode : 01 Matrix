class Solution {
    public int[][] updateMatrix(int[][] mat) {
        int m=mat.length;
        int n=mat[0].length;
        int[][] ans=new int[m][n];
        for(int i=0;i<m;i++){
            Arrays.fill(ans[i], -1);
        }
        Queue<int[]> queue=new LinkedList<>();
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(mat[i][j]==0){
                    ans[i][j]=0;
                    queue.offer(new int[]{i,j});
                }
            }
        }
        int[][] directions=new int[][]{{-1,0}, {1,0}, {0,-1}, {0,1}};

        while(queue.isEmpty()==false){
            int[] cur=queue.poll();
            int i=cur[0];
            int j=cur[1];

            for(int[] dir: directions){
                int new_i=i+dir[0];
                int new_j=j+dir[1];

                if(new_i>=0 && new_i<m && new_j>=0 && new_j<n && ans[new_i][new_j]==-1){
                    queue.offer(new int[]{new_i, new_j});
                    ans[new_i][new_j]=ans[i][j]+1;
                }
            }
        }   

        return ans;
    }
}
