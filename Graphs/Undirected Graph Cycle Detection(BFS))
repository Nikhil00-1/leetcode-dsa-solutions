class Solution {
    public static boolean bfs(ArrayList<ArrayList<Integer>> adj, Queue<int[]> queue,boolean[] visited){
        
        while(queue.isEmpty()==false){
            int[] cur=queue.poll();
            for(int i: adj.get(cur[0])){
                if(i==cur[1]){
                    continue;
                }
                if(visited[i]==true){
                    return true;
                }
                queue.offer(new int[]{i,cur[0]});
                visited[i]=true;
            }
        }
        return false;
    }
    public boolean isCycle(ArrayList<ArrayList<Integer>> adj) {
        
        int n=adj.size();
        boolean[] visited=new boolean[n];
        for(int i=0;i<n;i++){
            if(visited[i]==false){
                Queue<int[]> queue=new LinkedList<>();
                queue.offer(new int[]{i,-1});
                visited[i]=true;
                
                if(bfs(adj, queue, visited)==true){
                    return true;
                }
            }
        }
        return false;
    }
}
