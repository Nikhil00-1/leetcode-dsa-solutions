import java.util.*;
class Solution {
    public static boolean dfs(int u, ArrayList<ArrayList<Integer>> adj, int[] color, int cur){
        color[u]=cur;
        for(int v: adj.get(u)){
            if(color[v]==-1){
                if(dfs(v, adj, color, 1-cur)==false){
                    return false;
                }
            }
            if(color[v]==cur){
                return false;
            }
        }
        return true;
    }

    public boolean possibleBipartition(int n, int[][] dislikes) {
        
        ArrayList<ArrayList<Integer>> adj=new ArrayList<>();
        for(int i=0;i<=n;i++){
            adj.add(new ArrayList());
        }

        for(int i=0;i<dislikes.length;i++){
            int u=dislikes[i][0];
            int v=dislikes[i][1];

            adj.get(u).add(v);
            adj.get(v).add(u);
        }

        int[] color=new int[n+1];
        Arrays.fill(color, -1);

        for(int i=0;i<=n;i++){
            if(color[i]==-1){
                if(dfs(i, adj, color, 0)==false){
                    return false;
                };
            }
        }
        return true;
    }
}
