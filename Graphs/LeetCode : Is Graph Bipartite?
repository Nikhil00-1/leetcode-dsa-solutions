class Solution {
    static int[] color;
    public static boolean dfs(int cur, int[][] graph, int[] color, int curColor){
        color[cur]=curColor;
        for(int i: graph[cur]){
            if(color[i]==curColor){
                return false;
            }
            if(color[i]==-1){
                if(dfs(i, graph, color, 1-curColor)==false){
                    return false;
                }
            }
        }
        return true;
    }
    public boolean isBipartite(int[][] graph) {
        int n=graph.length;
        color= new int[n];
        Arrays.fill(color, -1);
        for(int i=0;i<n;i++){
            if(color[i]==-1){
                if(dfs(i, graph, color, 1)==false){
                    return false;
                }
            }
        }
        return true;
    }
}
