class Solution {
    public static void dfs(int[][] image, int i, int j, int color){
        
        if(i<0 || i>image.length-1 || j<0 || j>image[0].length-1 || image[i][j]==color){
            return;
        }
        int pre=image[i][j];
        image[i][j]=color;
        if(i>0 && image[i-1][j]==pre){
            dfs(image, i-1, j, color);
        }
        if(i<image.length-1 && image[i+1][j]==pre){
            dfs(image, i+1, j, color);
        }
        if(j>0 && image[i][j-1]==pre){
            dfs(image, i, j-1, color);
        }
        if(j<image[0].length-1 && image[i][j+1]==pre){
            dfs(image, i, j+1, color);
        }
    }
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {
        dfs(image, sr, sc, color);
        return image;
    }
}
