import java.util.*;
class Solution {
    public int minimumEffortPath(int[][] heights) {
        int m=heights.length;
        int n=heights[0].length;

        int[][] weights=new int[m][n];
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                weights[i][j]=Integer.MAX_VALUE;    
            }
        }
        PriorityQueue<int[]> queue=new PriorityQueue<>((a,b)->Integer.compare(a[0], b[0]));
        queue.offer(new int[]{0,0,0});
        int[][] directions=new int[][]{{0,1},{1,0},{0,-1},{-1,0}};
        weights[0][0]=0;
        while(!queue.isEmpty()){
            int[] cur=queue.poll();
            if(cur[1]==m-1 && cur[2]==n-1){
                return cur[0];
            }
            for(int[] dir:directions){
                int cur_i=dir[0]+cur[1];
                int cur_j=dir[1]+cur[2];

                if(cur_i>=0 && cur_j>=0 && cur_i<m && cur_j<n){
                    int cur_w=Math.max(cur[0],Math.abs(heights[cur_i][cur_j]-heights[cur[1]][cur[2]]));
                    if(weights[cur_i][cur_j]>cur_w){
                        weights[cur_i][cur_j]=cur_w;
                        queue.offer(new int[]{cur_w, cur_i, cur_j});
                    }
                }
            }
        }
        return 0;
    }
}
