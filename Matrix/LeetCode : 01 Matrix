import java.util.*;
class Solution {
    public int[][] updateMatrix(int[][] mat) {
        
        int m=mat.length;
        int n=mat[0].length;

        int[][] result=new int[m][n];

        for(int i=0;i<m;i++){
            Arrays.fill(result[i],-1);
        }
        Queue<int[]> q=new LinkedList<>();

        int[][] directions={{0,1},{0,-1},{1,0},{-1,0}};

        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(mat[i][j]==0){
                    result[i][j]=0;
                    q.offer(new int[]{i,j});
                }
                
            }
        }

        while(q.isEmpty()==false){
            int[] arr=q.poll();
            int r=arr[0];
            int c=arr[1];

            for(int[] temp:directions){
                int new_r=r+temp[0];
                int new_c=c+temp[1];

                if(new_r>=0 && new_r<m && new_c>=0 && new_c<n && result[new_r][new_c]==-1){
                    result[new_r][new_c]=result[r][c]+1;
                    q.offer(new int[]{new_r,new_c});
                }
            }
        }

        return result;
    }
}
