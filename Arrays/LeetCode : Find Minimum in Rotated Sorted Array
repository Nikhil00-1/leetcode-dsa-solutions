class Solution {
    public int findMin(int[] nums) {

        int l=0;
        int r=nums.length-1;
        int mid=(l+r)/2;

        while(l<r){
            mid=(l+r)/2;
            
            if(nums[mid+1]<nums[mid]){
                return nums[mid+1];
            }else if(mid-1>=0 && nums[mid]<nums[mid-1]){
                return nums[mid];
            }else if(nums[r]>nums[mid]){
                r=mid-1;
            }
            else if(nums[r]<nums[mid]){
                l=mid+1;
            }
        }
        return nums[l];
    }
}
