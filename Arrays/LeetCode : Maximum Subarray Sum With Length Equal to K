class Solution:
    def maxSubarraySum(self, nums: List[int], k: int) -> int:
        mx=float('-inf')
        n=len(nums)
        prefix=[0]*n
        prefix[0]=nums[0]
        for i in range(1,len(nums)):
            prefix[i]=nums[i]+prefix[i-1]

        for start in range(k):
            i=start
            curSum=0
            while i<n and i+k-1<n:
                j=i+k-1
                if i>0:
                    s=prefix[j]-prefix[i-1]
                else:
                    s=prefix[j]
                curSum=max(s,s+curSum)
                mx=max(mx,curSum)

                i=i+k
        return mx
