class Solution:
    def rearrangeArray(self, nums: List[int]) -> List[int]:
        posIndx=0
        negIndx=1
        ans=[0]*len(nums)
        for i in nums:
            if i<0:
                ans[negIndx]=i
                negIndx+=2
            else:
                ans[posIndx]=i
                posIndx+=2
        return ans
