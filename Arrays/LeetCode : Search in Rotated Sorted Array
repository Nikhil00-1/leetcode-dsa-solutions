class Solution {
    static int pivotFun(int[] nums){
        int i=0;
        int j=nums.length-1;
        int mid=(i+j)/2;
        while(i<j){
            mid=(i+j)/2;

            if(nums[mid]>nums[j]){
                i=mid+1;
            }
            else{
                j=mid;
            }
        }
        return i;
    }

    static int binarySearch(int l, int r, int[] nums, int target){
        int mid=(l+r)/2;
        while(l<=r){
            mid=(l+r)/2;
            if(nums[mid]==target){
                return mid;
            }
            if(nums[mid]>target){
                r=mid-1;
            }else{
                l=mid+1;
            }
        }
        return -1;
    }
    public int search(int[] nums, int target) {
        int pivot=pivotFun(nums);
        if(nums[pivot]==target){
            return pivot;
        }
        int ans=binarySearch(0,pivot-1,nums,target);
        if(ans!=-1){
            return ans;
        }
        return binarySearch(pivot,nums.length-1,nums,target);
    }
}
