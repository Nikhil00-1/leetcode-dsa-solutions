import java.util.*;

class Solution {
    public int maxArea(int[] height) {

        int i=0;
        int j=height.length-1;
        int max=Integer.MIN_VALUE;
        while(i<j){

            int len=j-i;
            int area=len*Math.min(height[i],height[j]);
            max=Math.max(max,area);

            if(height[i]<height[j]){
                i++;
            }else{
                j--;
            }
        }
        return max;
    }
}
