class Solution:
    def rotate(self, nums: List[int], k: int) -> None:
        if len(nums)>1:
            if len(nums)<k:
                a=k//len(nums)
                k=k%len(nums)
            nums.reverse()
            i=0
            j=k-1
            while i<j:
                temp=nums[i]
                nums[i]=nums[j]
                nums[j]=temp
                i+=1
                j-=1
            i=k
            j=len(nums)-1
            while i<j:
                temp=nums[i]
                nums[i]=nums[j]
                nums[j]=temp
                i+=1
                j-=1
