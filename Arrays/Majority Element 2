class Solution:
    def majorityElement(self, nums: List[int]) -> List[int]:
        n=len(nums)
        count1=0
        count2=0
        num1=None
        num2=None
        for i in range(len(nums)):
            if nums[i]==num1:
                count1+=1
            elif nums[i]==num2:
                count2+=1
            elif count1==0:
                num1=nums[i]
                count1=1
            elif count2==0:
                num2=nums[i]
                count2=1
            else:
                count1-=1
                count2-=1

        c1=nums.count(num1)
        c2=nums.count(num2)
        ans=[]
        if c1>n/3:
            ans.append(num1)
        if c2>n/3:
            ans.append(num2)
        return ans
