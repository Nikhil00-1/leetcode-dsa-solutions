class Solution {
    public double findMaxAverage(int[] nums, int k) {

        if(nums.length==1){
            return nums[0];
        }

        int n=nums.length;
        double sum=0;
        for(int i=0;i<k;i++){
            sum+=nums[i];
        }
        double avg=sum/k;
        double max=avg;
        for(int i=1;i<=n-k;i++){
            sum-=nums[i-1];
            sum+=nums[i+k-1];

            avg=sum/k;
            max=Math.max(max,avg);
        }

        return max;   
    }
}
