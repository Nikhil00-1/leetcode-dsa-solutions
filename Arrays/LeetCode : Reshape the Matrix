class Solution {
    public int[][] matrixReshape(int[][] mat, int r, int c) {
        
        int row=mat.length;
        int col=mat[0].length;

        if(r*c!=row*col){
            return mat;
        }

        int[][] mat2=new int[r][c];
        int i1=0;
        int j1=0;
        int i2=0;
        int j2=0;

        while(i1<mat.length && j1<mat[0].length){
            mat2[i2][j2]=mat[i1][j1];
            if(j1==col-1){
                i1++;
                j1=0;
            }else{
                j1++;
            }
            if(j2==mat2[0].length-1){
                i2++;
                j2=0;
            }else{
                j2++;
            }
        }
        return mat2;
    }
}
