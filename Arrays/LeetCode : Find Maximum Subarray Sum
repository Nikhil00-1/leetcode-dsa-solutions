import java.util.*;

class Solution {
    public int maxSubArray(int[] nums) {
        
        int max=Integer.MIN_VALUE;
        int total=0;

        for(int i=0;i<nums.length;i++){
            total+=nums[i];
            max=Math.max(max,total);
            
            if(total<0){
                total=0;
            }
        }

        return max;
    }
}
