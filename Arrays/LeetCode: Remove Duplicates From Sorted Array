import java.util.*;
class Solution {
    public int removeDuplicates(int[] nums) {
        
        int a=0;
        int b=0;

        for(int i=0;i<nums.length;i++){

            if(nums[i]!=nums[a]){
                a++;
                b++;
                nums[a]=nums[i];
            }
        }
        return b+1;
    }
}
