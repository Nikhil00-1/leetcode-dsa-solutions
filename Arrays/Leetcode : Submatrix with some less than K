class Solution(object):
    def countSubmatrices(self, grid, k):
        m=len(grid)
        n=len(grid[0])
        count=0

        for i in range(m):
            for j in range(n):
                
                top=grid[i-1][j] if i>0 else 0
                left=grid[i][j-1] if j>0 else 0
                topleft=grid[i-1][j-1] if i>0 and j>0 else 0

                grid[i][j]=grid[i][j]+top+left-topleft

                if grid[i][j]<=k:
                    count+=1
        return count
        
