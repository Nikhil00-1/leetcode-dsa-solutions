import java.util.*;

class Solution {
    public int maxSubarraySumCircular(int[] nums) {

        int max=Integer.MIN_VALUE;
        int maxsum=0;
        int min=Integer.MAX_VALUE;
        int minsum=0;
        int total=0;
        int n=nums.length;
        
        for(int i=0;i<n;i++){
            total+=nums[i];
            maxsum+=nums[i];
            max=Math.max(maxsum, max);
            
            if(maxsum<0){
                maxsum=0;
            }
        }

        for(int i=0;i<n;i++){
            minsum+=nums[i];
            min=Math.min(minsum,min);

            if(minsum>0){
                minsum=0;
            }
        }
       
        if(max<0){
            return max;
        }
        return Math.max(max, total-min);
    }
}
