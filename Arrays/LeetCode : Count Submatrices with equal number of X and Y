class Solution(object):
    def numberOfSubmatrices(self, grid):
        m=len(grid)
        n=len(grid[0])
        count=0
        countX = [[0]*n for _ in range(m)]
        for i in range(m):
            for j in range(n):
                x = 0
                
                if grid[i][j] == 'X':
                    x = 1

                top=grid[i-1][j] if i>0 else 0
                left=grid[i][j-1] if j>0 else 0
                topleft=grid[i-1][j-1] if i>0 and j>0 else 0

                if grid[i][j]=='X':
                    grid[i][j]=1+top+left-topleft
                elif grid[i][j]=='Y':
                    grid[i][j]=-1+top+left-topleft
                else:
                    grid[i][j]=0+top+left-topleft
                
                top_x = countX[i-1][j] if i > 0 else 0
                left_x = countX[i][j-1] if j > 0 else 0
                diag_x = countX[i-1][j-1] if i > 0 and j > 0 else 0

                countX[i][j] = x + top_x + left_x - diag_x

                if grid[i][j]==0 and countX[i][j] > 0:
                    count+=1
        return count
