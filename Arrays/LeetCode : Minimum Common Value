class Solution {
    public int getCommon(int[] nums1, int[] nums2) {
        
        int a1=nums1.length;
        int a2=nums2.length;

        int i=0;
        int j=0;

        while(i<a1 && j<a2){

            if(nums1[i]==nums2[j]){
                return nums1[i];
            }
            if(nums1[i]<nums2[j]){
                i++;
            }
            else{
                j++;
            }
        }
        return -1;
    }
}
