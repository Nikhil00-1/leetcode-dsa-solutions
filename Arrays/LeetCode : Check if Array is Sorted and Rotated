import java.util.*;
class Solution {
    public boolean check(int[] nums) {
        int arr[]=nums.clone();
        Arrays.sort(arr);
        int f=0;
        for(int i=1;i<nums.length;i++){
            if(nums[i]<nums[i-1]){
                f=i;
            }
        }
        if(f==0){
            return true;
        }
        int x=nums.length-f;

        for(int i=0;i<nums.length;i++){
            if(nums[i]!=arr[(i+x)%nums.length]){
                return false;
            }
        }
        return true;
    }
}
