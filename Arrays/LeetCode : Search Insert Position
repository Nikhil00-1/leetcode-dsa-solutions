class Solution {
    public int searchInsert(int[] nums, int target) {
        
        int n=nums.length;
        int i=0;
        int j=n-1;
        int mid=(i+j)/2;

        while(i<=j){
            if(nums[mid]==target){
                return mid;
            }else if(nums[mid]<target){
                i=mid+1;
            }else{
                j=mid-1;
            }
            mid=(i+j)/2;
        }
        if(target<nums[mid]){
            if(mid-1>=0)
                return mid-1;
            else
                return 0;
        }else{
            return mid+1;
        }
    }
}
