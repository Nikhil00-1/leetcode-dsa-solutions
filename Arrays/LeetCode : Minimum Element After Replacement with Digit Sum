class Solution {
    public int minElement(int[] nums) {
        int[] ans=new int[nums.length];
        for(int i=0;i<nums.length;i++){
            int num=nums[i];
            int sum=0;
            while(num!=0){
                sum=sum+num%10;
                num=num/10;
            }

            ans[i]=sum;
        }
        int m=Integer.MAX_VALUE;
        for(int i=0;i<nums.length;i++){
            m=Math.min(m,ans[i]);
        }
        return m;
    }
}
