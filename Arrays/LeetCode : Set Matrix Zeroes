class Solution:
    def setZeroes(self, matrix: List[List[int]]) -> None:
        """
        Do not return anything, modify matrix in-place instead.
        """
        m=len(matrix)
        n=len(matrix[0])
        f=0
        if 0 in matrix[0]:
            f=1
        
        for j in range(n):
            for a in range(m):
                if matrix[a][j]==0:
                    matrix[0][j]='u'

        for i in range(1,m):
            if 0 in matrix[i]:
                matrix[i][0]='y'
        
        for p in range(1,m):
            if matrix[p][0]=='y':
                for q in range(n):
                    matrix[p][q]=0

        for g in range(n):
            if matrix[0][g]=='u':
                for h in range(m):
                    matrix[h][g]=0
        if f==1:
            for z in range(n):
                matrix[0][z]=0

