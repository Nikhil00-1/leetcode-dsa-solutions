class Solution {
    static int fun(int i, int j, int[][] grid, boolean[][] visited){
        int m=grid.length;
        int n=grid[0].length;

        if(i<0 || i>=m || j<0 || j>=n || grid[i][j]==0 || visited[i][j]==true){
            return 0;
        }
        visited[i][j]=true;

        int up = fun(i - 1, j, grid, visited);
        int down = fun(i + 1, j, grid, visited);
        int left = fun(i, j - 1, grid, visited);
        int right = fun(i, j + 1, grid, visited);

        visited[i][j] = false; // backtracking

        return grid[i][j] + Math.max(Math.max(up, down),
                                     Math.max(left, right));
    }
    public int getMaximumGold(int[][] grid) {

        int max=0;
        int m=grid.length;
        int n=grid[0].length;
        for(int i=0;i<grid.length;i++){
            for(int j=0;j<grid[0].length;j++){
                if(grid[i][j]!=0){
                    boolean[][] visited=new boolean[m][n];
                    
                    int c=fun(i,j,grid,visited);
                    if(c>max){
                        max=c;
                    }
                }
            }
        }
        return max;
    }
}
