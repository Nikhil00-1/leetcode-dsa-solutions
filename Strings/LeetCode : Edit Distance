class Solution {
    static int[][] dp=new int[501][501];
    public static int help(String s1, String s2, int i, int j){
        if(i==s1.length()){
            return s2.length()-j;
        }else if(j==s2.length()){
            return s1.length()-i;
        }
        if(dp[i][j]!=-1){
            return dp[i][j];
        }
        if(s1.charAt(i)==s2.charAt(j)){
            return help(s1, s2, i+1, j+1);
        }else{
            int a1=1+help(s1, s2, i+1,j);
            int a2=1+help(s1, s2, i, j+1);
            int a3=1+help(s1, s2, i+1, j+1);
            dp[i][j]= Math.min(Math.min(a1, a2), a3);
            return dp[i][j];
        }
        
    }
    public int minDistance(String word1, String word2) {
        for(int i=0;i<501;i++){
            for(int j=0;j<501;j++){
                dp[i][j]=-1;
            }
        }

        return help(word1, word2, 0, 0);
    }
}
