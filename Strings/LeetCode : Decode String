class Solution {
    public String decodeString(String s) {
        
        Stack<StringBuilder> stStr=new Stack();
        Stack<Integer> stCount=new Stack();
        StringBuilder s1=new StringBuilder();
        int count=0;

        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);

            if(Character.isDigit(ch)){
                count=(count*10) + ch-'0';
            }else if(ch=='['){
                stStr.push(s1);
                stCount.push(count);
                s1=new StringBuilder();
                count=0;
            }else if(ch==']'){
                StringBuilder s2=stStr.pop();
                int n=stCount.pop();

                for(int j=0;j<n;j++){
                    s2.append(s1);
                }
                s1=s2;
            }else{
                s1.append(ch);
            }
        }
        return s1.toString();
    }
}
