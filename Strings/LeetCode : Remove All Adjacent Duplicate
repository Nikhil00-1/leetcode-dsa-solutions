class Solution {
    public String removeDuplicates(String s, int k) {
        int n=s.length();
        Stack<HashMap<Character, Integer>> st=new Stack<>();
        StringBuilder sb=new StringBuilder();
        for(int i=0;i<n;i++){
            char ch=s.charAt(i);
            
            if(!st.isEmpty() && st.peek().keySet().iterator().next()==ch && st.peek().get(ch)==k-1){
                st.pop();
            }else if(!st.isEmpty() && st.peek().keySet().iterator().next()==ch && st.peek().get(ch)<k){
                int v=st.peek().get(ch);
                st.peek().put(ch, v+1);
            }else{
                HashMap<Character, Integer> m=new HashMap<>();
                m.put(ch,1);
                st.push(m);
            }
        }

        for(HashMap<Character, Integer> mp:st){
            char key=mp.keySet().iterator().next();
            int val=mp.get(key);

            while(val-->0){
                sb.append(key);
            }
        }
        return new String(sb);
    }
}
