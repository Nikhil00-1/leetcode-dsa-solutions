class Solution {
    public String removeDuplicateLetters(String s) {

    StringBuilder sb=new StringBuilder();
    int[] last=new int[26];
    int[] map=new int[26];

    for(int i=0;i<s.length();i++){
        last[s.charAt(i)-'a']=i;
    }

    for(int i=0;i<s.length();i++){
        char ch=s.charAt(i);
        if(sb.length()==0){
            sb.append(ch);
            map[ch-'a']=1;
        }
        else if(sb.charAt(sb.length()-1)>ch && map[ch-'a']!=1){
            while(sb.length()>0 && last[sb.charAt(sb.length()-1)-'a']>i && ch<sb.charAt(sb.length()-1)){
                map[sb.charAt(sb.length()-1)-'a']=0;
                sb.deleteCharAt(sb.length()-1);
            }
            sb.append(ch);
            map[ch-'a']=1;
        }else{
            if(map[ch-'a']!=1){
                sb.append(ch);
                map[ch-'a']=1;
            }
            
        }
    }
    return sb.toString();
    }
}
