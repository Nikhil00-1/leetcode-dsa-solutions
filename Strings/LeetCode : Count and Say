class Solution {
    static ArrayList<ArrayList<Integer>> help1(StringBuilder s){
        ArrayList<ArrayList<Integer>> arr=new ArrayList<>();

        int count=0;
        int i=0;
        int n=s.length();
        char ch=s.charAt(0);
        while(i<n){
            if(ch==s.charAt(i)){
                count++;
            }else{
                ArrayList<Integer> temp=new ArrayList<>();
                temp.add(count);
                temp.add(ch-'0');
                arr.add(temp);
                count=1;
                ch=s.charAt(i);
            }
            i++;
        }
        ArrayList<Integer> temp = new ArrayList<>();
        temp.add(count);
        temp.add(ch - '0');
        arr.add(temp);
        return arr;
    }

    static StringBuilder help2(ArrayList<ArrayList<Integer>> arr){
        StringBuilder sb=new StringBuilder();

        for(ArrayList a:arr){
            sb.append(String.valueOf(a.get(0)));
            sb.append(String.valueOf(a.get(1)));
        }

        return sb;
    }
    public String countAndSay(int n) {
        
        StringBuilder str=new StringBuilder();
        ArrayList<ArrayList<Integer>> arr=new ArrayList<>();
        str.append("1");
        int i=0;
        while(i<n-1){
            arr=help1(str);
            str=help2(arr);
            i++;
        }

        return new String(str);
    }
}
