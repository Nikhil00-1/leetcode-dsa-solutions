class Solution {

    ArrayList<ArrayList<Integer>> help1(String s){

        int i=0;
        ArrayList<ArrayList<Integer>> arr=new ArrayList<>();
        while(i<s.length()){
            char cur=s.charAt(i);
            int count=0;
            int j=i;
            while(j<s.length() && cur==s.charAt(j)){
                count++;
                j++;
            }
            ArrayList<Integer> row=new ArrayList<>();
            row.add(cur-'0');
            row.add(count);
            arr.add(row);
            i=j;
        }
        return arr;
    }

    String help2(ArrayList<ArrayList<Integer>> arr){
        
        StringBuilder sb = new StringBuilder();
        for(int i=0;i<arr.size();i++){
            char c=(char)(arr.get(i).get(0)+'0');
            int x=arr.get(i).get(1);
            sb.append(x);
            sb.append(c);

        }
        return sb.toString();
    }

    public String countAndSay(int n) {
        String strr="1";
        for(int i=0;i<n-1;i++){
            ArrayList<ArrayList<Integer>> arry=help1(strr);
            strr=help2(arry);
        }
        return strr;
    }
}
