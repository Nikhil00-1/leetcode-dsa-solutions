class Solution {
    public int bestClosingTime(String c) {
        int n=c.length();
        int[] suf=new int[n];
        int[] pref=new int[n];
        int cur=0;
        for(int i=0;i<n;i++){
            if(c.charAt(i)=='N'){
                cur++;
            }
            pref[i]=cur;
        }
        int cur2=0;
        for(int j=n-1;j>=0;j--){
            if(c.charAt(j)=='Y'){
                cur2++;
            }
            suf[j]=cur2;
        }

        int[] arr=new int[n+1];

        for(int i=0;i<n-1;i++){
            
            arr[i+1]=pref[i]+suf[i+1];
        }
        arr[0]=suf[0];
        arr[n]=pref[n-1];
        
        int min=Integer.MAX_VALUE;
        for(int i=0;i<arr.length;i++){
            min=Math.min(min, arr[i]);
        }
        int ans=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]==min){
                ans=i;
                break;
            }
        }
        return ans;
    }
}
