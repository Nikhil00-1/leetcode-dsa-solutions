class Solution {
    public int strStr(String s, String needle) {
        int i=0;
        int j=0;
        int n=s.length();
        while(i<n){
            if(s.charAt(i)==needle.charAt(0)){
                int p=i;
                j=0;
                while(i<n && j<needle.length() && s.charAt(i)==needle.charAt(j)){
                    i++;
                    j++;
                }
                if(j==needle.length()){
                    
                    return p;
                }
                i=p+1;
            }
            else{
                 i++;
            }
        }
        return -1;
    }
}
