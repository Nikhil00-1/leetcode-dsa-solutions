class Solution {
    public String mergeAlternately(String word1, String word2) {
        
        StringBuilder sb=new StringBuilder();
        int i=0;
        int j=0;
        int n1=word1.length();
        int n2=word2.length();
        int turn=1;

        while(i<n1 && j<n2){
            if(turn==1){
                sb.append(word1.charAt(i));
                turn=2;
                i++;
            }else{
                sb.append(word2.charAt(j));
                turn=1;
                j++;
            }
        }

        if(i==n1){
            sb.append(word2.substring(j,n2));
        }else{
            sb.append(word1.substring(i,n1));
        }

        return sb.toString();
    }
}
