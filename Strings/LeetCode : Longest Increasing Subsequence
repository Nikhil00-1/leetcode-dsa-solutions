class Solution {
    int[][] dp=new int[2501][2501];
    public int help(int i, int j, int[] nums){
        if(i>=nums.length){
            return 0;
        }
        if(dp[i+1][j+1]!=-1){
            return dp[i+1][j+1];
        }
        int take=0;
        int skip=0;
        if(j==-1 || nums[i]>nums[j]){
            take=1+help(i+1, i, nums);
        }
        skip=help(i+1, j, nums);
        dp[i+1][j+1]=Math.max(skip, take);
        return dp[i+1][j+1];

    }
    public int lengthOfLIS(int[] nums) {
        for(int i=0;i<2501;i++){
            for(int j=0;j<2501;j++){
                dp[i][j]=-1;
            }
        }
        return help(0, -1, nums);
    }
}
