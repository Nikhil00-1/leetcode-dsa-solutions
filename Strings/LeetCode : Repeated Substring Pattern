class Solution {
    public boolean repeatedSubstringPattern(String s) {
       
        int n=s.length();
        for(int i=(n/2)-1;i>=0;i--){
            if(n%(i+1)==0){
                int times=n/(i+1);
                String sub=s.substring(0,i+1);
                StringBuilder sb=new StringBuilder();
                while(times-->0){
                    sb.append(sub);
                }
                if(s.equals(sb.toString())){
                    return true;
                }
            }
        }
        return false;
    }
}
