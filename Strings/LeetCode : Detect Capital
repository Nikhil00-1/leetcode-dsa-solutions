class Solution {
    public boolean detectCapitalUse(String s) {
        
        if(s.equals(s.toUpperCase()))
            return true;
        else if(s.equals(s.toLowerCase()))
            return true;
        else{
            String w=s.substring(1,s.length());
            if(w.equals(w.toLowerCase()) && Character.isUpperCase(s.charAt(0))){
                return true;
            }
        }

        return false;
    }
}
