class Solution:
    def checkStrings(self, s1: str, s2: str) -> bool:
        
        s1odd={}
        s1even={}
        s2odd={}
        s2even={}
        for i in range(len(s1)):
            if i%2==0:
                if s1[i] in s1even:
                    s1even[s1[i]]+=1
                else:
                    s1even[s1[i]]=1
            else:
                if s1[i] in s1odd:
                    s1odd[s1[i]]+=1
                else:
                    s1odd[s1[i]]=1

        for i in range(len(s2)):
            if i%2==0:
                if s2[i] in s2even:
                    s2even[s2[i]]+=1
                else:
                    s2even[s2[i]]=1
            else:
                if s2[i] in s2odd:
                    s2odd[s2[i]]+=1
                else:
                    s2odd[s2[i]]=1
        for i in s1odd:
            if i in s2odd and s1odd[i]==s2odd[i]:
                continue
            else:
                return False
        else:
            flag=True
        
        for j in s1even:
            if j in s2even and s1even[j]==s2even[j]:
                continue
            else:
                return False
        else:
            return True and flag
