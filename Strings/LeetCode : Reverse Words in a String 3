import java.util.*;

class Solution {

    public String reverseWords(String s) {
        int len=s.length();
        int st=0;
        StringBuilder sb=new StringBuilder();
        for(int i=0;i<len;i++){
            if(s.charAt(i)==' '){
                sb.append(new StringBuilder(s.substring(st,i)).reverse());
                sb.append(" ");
                st=i+1;
            }
            
        }
        sb.append(new StringBuilder(s.substring(st,len)).reverse());
        return sb.toString();
    }
}
