class Solution {
    public static void help(char[] arr,int i,int j){
            while(i<j){
                char temp=arr[i];
                arr[i]=arr[j];
                arr[j]=temp;
                i++;
                j--;
            }
        }

    public String reverseStr(String s, int k) {        
        char[] arr=s.toCharArray();

        if(k>=arr.length){
            help(arr,0,arr.length-1);
            return new String(arr);
        }
        
        int i=0;
        while(i<arr.length){
            int a=i;
            int b=i+k-1;
            if(i+k-1<arr.length){
                help(arr,a,b);
            }else{
                help(arr,a,arr.length-1);
            }
            i=i+ 2*k;
        }
        
        return new String(arr);
    }
}
