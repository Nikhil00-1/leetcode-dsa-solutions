class Solution {
    public int lengthOfLongestSubstring(String s) {
        
        int max=0;
        int n=s.length();
        HashSet<Character> set=new HashSet<>();

        int i=0;
        int j=0;
        
        while(j<n){
            char ch=s.charAt(j);
            if(set.contains(ch)){
                while(set.contains(ch)){
                    set.remove(s.charAt(i));
                    i++;
                }
            }
            set.add(ch);
            max=Math.max(max, set.size());
            j++;

        }
        return max;
    }
}
