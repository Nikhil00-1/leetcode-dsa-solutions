class Solution {
    static Boolean[] dp;
    public static boolean help(int i, String s, HashSet<String> set){
        if(i==s.length()){
            return true;
        }

        if(dp[i] != null){
            return dp[i];
        }

        for(int j=i;j<=s.length();j++){
            String sb=s.substring(i,j);

            if(set.contains(sb) && help(j, s, set)){
                dp[i]= true;
                return dp[i];
            }
        }
        dp[i]=false;
        return dp[i];
    }
    
    public boolean wordBreak(String s, List<String> wordDict) {
        HashSet<String> set=new HashSet();

        for(int i=0;i< wordDict.size();i++){
            set.add(wordDict.get(i));
        }
        dp=new Boolean[s.length()];
        
        return help(0, s, set);
    }
}
