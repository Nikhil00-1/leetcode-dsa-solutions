class Solution {
    public String makeGood(String s) {
        int n=s.length();
        Stack<Character> st=new Stack<>();
        StringBuilder sb=new StringBuilder();

        for(int i=0;i<n;i++){
            char ch=s.charAt(i);
            if(!st.isEmpty()){
                if(Character.isLowerCase(st.peek()) && Character.isUpperCase(ch) && Character.toUpperCase(st.peek())==ch){
                    st.pop();
                }else if(Character.isUpperCase(st.peek()) && Character.isLowerCase(ch) && Character.toLowerCase(st.peek())==ch){
                    st.pop();
                }else{
                    st.push(ch);
                }
            }else{
                st.push(ch);
            }
        }

        for(char ch:st){
            sb.append(ch);
        }

        return new String(sb);
    }
}
