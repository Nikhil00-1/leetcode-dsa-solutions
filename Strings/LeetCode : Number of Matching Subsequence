import java.util.*;

class Solution {
    public int numMatchingSubseq(String s, String[] words) {

        // Store positions of every character
        List<Integer>[] positions = new ArrayList[26];

        for (int i = 0; i < 26; i++) {
            positions[i] = new ArrayList<>();
        }

        // Preprocess s
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            positions[ch - 'a'].add(i);
        }

        int count = 0;

        // Check every word
        for (String word : words) {
            if (isSubsequence(word, positions)) {
                count++;
            }
        }

        return count;
    }

    private boolean isSubsequence(String word, List<Integer>[] positions) {

        int prev = -1;

        for (char ch : word.toCharArray()) {

            List<Integer> list = positions[ch - 'a'];

            // Find first position > prev
            int index = upperBound(list, prev);

            if (index == list.size()) {
                return false;
            }

            prev = list.get(index);
        }

        return true;
    }

    // First element greater than target
    private int upperBound(List<Integer> list, int target) {

        int left = 0;
        int right = list.size();

        while (left < right) {

            int mid = left + (right - left) / 2;

            if (list.get(mid) <= target) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }

        return left;
    }
}
