class Solution:
    def minDistance(self, word1: str, word2: str) -> int:
        
        dp=[[-1]*500 for _ in range(500)]
    
        def fun(i,j):
            if i>=len(word1):
                return len(word2)-j
            if j>=len(word2):
                return len(word1)-i
            
            if dp[i][j]!=-1:
                return dp[i][j]
            if word1[i]==word2[j]:
                dp[i][j]=fun(i+1,j+1)
                return dp[i][j]
            else:
                dp[i][j]=min(1+fun(i+1,j), 1+fun(i,j+1))
                return dp[i][j]
        return fun(0,0)
