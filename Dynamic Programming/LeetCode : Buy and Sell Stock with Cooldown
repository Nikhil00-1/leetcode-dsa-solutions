class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        
        dp=[[-1]*2 for _ in range(5001)]

        def fun(i,state):
            if i>=len(prices):
                return 0
            profit=0
            if dp[i][state]!=-1:
                return dp[i][state]
            if state:
                take=fun(i+1,0)-prices[i]
                notake=fun(i+1,1)
                profit=max(profit, take, notake)
            else:
                sell=prices[i]+fun(i+2,1)
                nosell=fun(i+1,0)
                profit=max(profit, sell, nosell)
            dp[i][state]=profit
            return profit
        return fun(0,1)
