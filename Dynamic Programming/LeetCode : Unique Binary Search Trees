class Solution(object):
    def numTrees(self, n):
        dp=[-1]*(n+1)
        
        def fun(n):
            if n==0 or n==1:
                return 1
            if dp[n]!=-1:
                return dp[n]
            ans=0
            for i in range(1,n+1):
                ans=ans+(fun(i-1)*fun(n-i))
            dp[n]=ans
            return ans
        return fun(n)
        
