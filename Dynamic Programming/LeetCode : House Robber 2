class Solution(object):
    def rob(self, nums):
        
        if len(nums)<2:
            return max(nums)
        n=len(nums)
        nums1=nums[:n-1]
        nums2=nums[1:]
        dp1=[-1]*(n-1)
        dp2=[-1]*(n-1)
        
        def fun1(i):
            if i>n-2:
                return 0
            if dp1[i]!=-1:
                return dp1[i] 
            
            dp1[i]=max(nums1[i]+fun1(i+2), fun1(i+1))
            return dp1[i]

        def fun2(i):
            if i>n-2:
                return 0
            if dp2[i]!=-1:
                return dp2[i] 
            dp2[i]=max(nums2[i]+fun2(i+2), fun2(i+1))
            return dp2[i]
        
        fun1(0)
        fun2(0)
        print(dp1,dp2)
        return max(max(dp1),max(dp2))

