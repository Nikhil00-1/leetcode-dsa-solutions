class Solution:
    def integerBreak(self, n: int) -> int:
        
        dp=[-1]*(n+1)

        def fun(n):
            if dp[n]!=-1:
                return dp[n]
            res=0
            for i in range(1,n):
                prod=i*max(n-i, fun(n-i))
                res=max(res, prod)
            dp[n]=res
            return dp[n]
        fun(n)
        return max(dp)
