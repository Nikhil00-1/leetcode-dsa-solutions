class Solution:
    def countArrangement(self, n: int) -> int:
        
        count=0
        used=[False]*(n+1)

        def fun(pos):
            nonlocal count
            if pos>n:
                count+=1

            for i in range(1,n+1):
                if (not used[i]) and (i%pos==0 or pos%i==0):
                    used[i]=True
                    fun(pos+1)
                    used[i]=False
        fun(1)
        return count
