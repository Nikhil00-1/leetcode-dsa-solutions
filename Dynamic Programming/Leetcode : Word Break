class Solution:
    def wordBreak(self, s: str, wordDict: List[str]) -> bool:
        n=len(s)
        dp=[-1]*n

        def fun(i):
            if i==n:
                return True
            if s in wordDict:
                return True
            if dp[i]!=-1:
                return dp[i]
            for j in range(i,n):
                if s[i:j+1] in wordDict and fun(j+1):
                    dp[i]=True
                    return dp[i]
            dp[i]=False
            return dp[i]
        return fun(0)
