class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        n=len(prices)
        dp=[[None]*2 for _ in range(n)]

        def fun(i,flag):
            if i==n:
                return 0
            if dp[i][flag]!=None:
                return dp[i][flag]
            if flag==1:
                buy=-prices[i]+fun(i+1,0)
                n_buy=fun(i+1,1)
                profit=max(buy,n_buy)
            else:
                sell=prices[i]+fun(i+1,1)
                n_sell=fun(i+1,0)
                profit=max(sell,n_sell)
            dp[i][flag]=profit
            return profit
        return fun(0,1)
