class Solution(object):
    def climbStairs(self, n, costs):
        """
        :type n: int
        :type costs: List[int]
        :rtype: int
        """
        dp=[0]*(n+1)
        
        for j in range(1,n+1):
            dp[j] = min(dp[i] + costs[j-1] + (j - i)**2 for i in [j-1, j-2, j-3] if i >= 0)
        return dp[n]

