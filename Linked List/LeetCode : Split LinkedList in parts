/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */
class Solution {
    public ListNode[] splitListToParts(ListNode head, int k) {

        ListNode temp;
        temp=head;
        int n=0;
        while(temp!=null){
            n++;
            temp=temp.next;
        }

        int ps=n/k;
        int g=n%k;

        ListNode[] ans=new ListNode[k];

        ListNode cur=head;
        int index=0;

        while(cur!=null){

            if(g!=0){
                int target=ps+1;
                ListNode demo;
                ListNode curList=new ListNode();
                demo=curList;
                while(cur != null && target > 0){

                    curList.val = cur.val;
                    cur = cur.next;
                    target--;

                    if(target > 0){
                        curList.next = new ListNode();
                        curList = curList.next;
                    }
                    }
                ans[index++]=demo;
                g--;
            }else{
                int target=ps;
                ListNode demo;
                ListNode curList=new ListNode();
                demo=curList;
                while(cur != null && target > 0){

                    curList.val = cur.val;
                    cur = cur.next;
                    target--;

                    if(target > 0){
                        curList.next = new ListNode();
                        curList = curList.next;
                    }
                }
                ans[index++]=demo;
            }

        }  
        return ans;
    }
}
