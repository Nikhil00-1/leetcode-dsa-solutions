import java.util.*;
class Solution {
    public Node copyRandomList(Node head) {
        
        Node prev=null;
        Node newHead=null;
        Node curr=head;

        HashMap<Node, Node> map=new HashMap<>();

        while(curr!=null){
            Node temp=new Node(curr.val);
            map.put(curr,temp);

            if(newHead==null){
                newHead=temp;
                prev=newHead;
            }else{
                prev.next=temp;
                prev=prev.next;
            }

            curr=curr.next;
        }

        curr=head;
        Node newcurr=newHead;
        while(curr!=null){
            if(curr.random==null){
                newcurr.random=null;
            }else{
                newcurr.random=map.get(curr.random);
            }
            curr=curr.next;
            newcurr=newcurr.next;
        }
        return newHead;
    }
}
